# API Keys
API_KEY=default_api_key

# Storage Configuration
METADATA_SQLITE_PATH=data/metadata.db
LOCAL_STORAGE_PATH=static/images

# Public image domain. Include http:// or https://; bare localhost is normalized to http://.
CUSTOM_DOMAIN=

# Upload and Conversion Settings
# Maximum number of images allowed in a single upload (Need Self build default: 20)
# Image quality for WebP/AVIF conversion (1-100, default: 75)
# Whether to generate and expose AVIF images (true/false, default: false)
# Number of parallel worker threads for batch processing
# Size of worker pool for concurrent image processing
# SPEED: Range: 0-8, 0=slowest/highest quality, 8=fastest/lowest quality
MAX_UPLOAD_COUNT=20
IMAGE_QUALITY=75
AVIF_ENABLED=false
WORKER_THREADS=2
WORKER_POOL_SIZE=1
SPEED=4

# Frontend Configuration Only for Docker Build
# if Frontend and Backend are separated, you can set the API URL here
NEXT_PUBLIC_API_URL=

# Debug Mode
DEBUG_MODE=false
